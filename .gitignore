# The owner's boat. Never commit one.
boat.toml
*.local.toml
.private-markers

# Secrets and local state
.env
.env.*
*.key
*.pem
security.json
.local/

# The Signal K config a user actually runs. The *.example.json templates are tracked; the
# files copied from them carry a real vessel name, MMSI and position, so they are not.
signalk/signalk-config/*.json
signalk/signalk-config/plugin-config-data/*.json
!signalk/signalk-config/*.example.json
!signalk/signalk-config/plugin-config-data/*.example.json

# Generated
reports/
*.sqlite
*.sqlite-shm
*.sqlite-wal
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Test scratch: the control-gate tests write a journal to prove the gate records refusals.
tests/_tmp/
